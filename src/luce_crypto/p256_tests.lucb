## Curve regression vectors, built and executed in every backend.
from luce_crypto.p256 import verify, public_from_private, keygen, sign, ecdh

func verify_rfc6979() -> !:
    let qx = b"\x60\xfe\xd4\xba\x25\x5a\x9d\x31\xc9\x61\xeb\x74\xc6\x35\x6d\x68\xc0\x49\xb8\x92\x3b\x61\xfa\x6c\xe6\x69\x62\x2e\x60\xf2\x9f\xb6"
    let qy = b"\x79\x03\xfe\x10\x08\xb8\xbc\x99\xa4\x1a\xe9\xe9\x56\x28\xbc\x64\xf2\xf1\xb2\x0c\x2d\x7e\x9f\x51\x77\xa3\xc2\x94\xd4\x46\x22\x99"
    let e = b"\xaf\x2b\xdb\xe1\xaa\x9b\x6e\xc1\xe2\xad\xe1\xd6\x94\xf4\x1f\xc7\x1a\x83\x1d\x02\x68\xe9\x89\x15\x62\x11\x3d\x8a\x62\xad\xd1\xbf"
    let r = b"\xef\xd4\x8b\x2a\xac\xb6\xa8\xfd\x11\x40\xdd\x9c\xd4\x5e\x81\xd6\x9d\x2c\x87\x7b\x56\xaa\xf9\x91\xc3\x4d\x0e\xa8\x4e\xaf\x37\x16"
    let s = b"\xf7\xcb\x1c\x94\x2d\x65\x7c\x41\xd4\x36\xc7\xa1\xb6\xe2\x9f\x65\xf3\xe9\x00\xdb\xb9\xaf\xf4\x06\x4d\xc4\xab\x2f\x84\x3a\xcd\xa8"
    assert(try verify(qx, qy, e, r, s))
    # A tampered s must be rejected.
    let bad = b"\xf7\xcb\x1c\x94\x2d\x65\x7c\x41\xd4\x36\xc7\xa1\xb6\xe2\x9f\x65\xf3\xe9\x00\xdb\xb9\xaf\xf4\x06\x4d\xc4\xab\x2f\x84\x3a\xcd\xa9"
    assert(not (try verify(qx, qy, e, r, bad)))

func derive_rfc6979() -> !:
    let d = b"\xc9\xaf\xa9\xd8\x45\xba\x75\x16\x6b\x5c\x21\x57\x67\xb1\xd6\x93\x4e\x50\xc3\xdb\x36\xe8\x9b\x12\x7b\x8a\x62\x2b\x12\x0f\x67\x21"
    let qx = b"\x60\xfe\xd4\xba\x25\x5a\x9d\x31\xc9\x61\xeb\x74\xc6\x35\x6d\x68\xc0\x49\xb8\x92\x3b\x61\xfa\x6c\xe6\x69\x62\x2e\x60\xf2\x9f\xb6"
    let qy = b"\x79\x03\xfe\x10\x08\xb8\xbc\x99\xa4\x1a\xe9\xe9\x56\x28\xbc\x64\xf2\xf1\xb2\x0c\x2d\x7e\x9f\x51\x77\xa3\xc2\x94\xd4\x46\x22\x99"
    var got_x: u8[32]
    var got_y: u8[32]
    try public_from_private(d, got_x, got_y)
    for i in 0..<32:
        assert(got_x[i] == qx[i])
        assert(got_y[i] == qy[i])

func signing_roundtrip() -> !:
    var d: u8[32]
    var qx: u8[32]
    var qy: u8[32]
    try keygen(d, qx, qy)
    let e = b"\xaf\x2b\xdb\xe1\xaa\x9b\x6e\xc1\xe2\xad\xe1\xd6\x94\xf4\x1f\xc7\x1a\x83\x1d\x02\x68\xe9\x89\x15\x62\x11\x3d\x8a\x62\xad\xd1\xbf"
    var r: u8[32]
    var s: u8[32]
    try sign(d, e, r, s)
    assert(try verify(qx, qy, e, r, s))
    s[31] = s[31] ^ 1
    assert(not (try verify(qx, qy, e, r, s)))

## Wycheproof ecdh_secp256r1_ecpoint case 1, a key agreement round trip and
## rejection of a point that is not on the curve.
func ecdh_cases() -> !:
    let qx = b"\x62\xd5\xbd\x33\x72\xaf\x75\xfe\x85\xa0\x40\x71\x5d\x0f\x50\x24\x28\xe0\x70\x46\x86\x8b\x0b\xfd\xfa\x61\xd7\x31\xaf\xe4\x4f\x26"
    let qy = b"\xac\x33\x3a\x93\xa9\xe7\x0a\x81\xcd\x5a\x95\xb5\xbf\x8d\x13\x99\x0e\xb7\x41\xc8\xc3\x88\x72\xb4\xa0\x7d\x27\x5a\x01\x4e\x30\xcf"
    let d = b"\x06\x12\x46\x5c\x89\xa0\x23\xab\x17\x85\x5b\x0a\x6b\xce\xbf\xd3\xfe\xbb\x53\xae\xf8\x41\x38\x64\x7b\x53\x52\xe0\x2c\x10\xc3\x46"
    let expected = b"\x53\x02\x0d\x90\x8b\x02\x19\x32\x8b\x65\x8b\x52\x5f\x26\x78\x0e\x3a\xe1\x2b\xcd\x95\x2b\xb2\x5a\x93\xbc\x08\x95\xe1\x71\x42\x85"
    var shared: u8[32]
    try ecdh(d, qx, qy, shared)
    for i in 0..<32: assert(shared[i] == expected[i], "P-256 ECDH vector mismatch")
    var d1: u8[32]
    var x1: u8[32]
    var y1: u8[32]
    var d2: u8[32]
    var x2: u8[32]
    var y2: u8[32]
    try keygen(d1, x1, y1)
    try keygen(d2, x2, y2)
    var s1: u8[32]
    var s2: u8[32]
    try ecdh(d1, x2, y2, s1)
    try ecdh(d2, x1, y1, s2)
    for i in 0..<32: assert(s1[i] == s2[i], "P-256 ECDH disagreement")
    y2[31] ^= 1
    var rejected = false
    ecdh(d1, x2, y2, s1) catch failure:
        discard(failure)
        rejected = true
        recover ()
    assert(rejected, "off-curve ECDH peer accepted")

pub func main(arguments: str[]) -> i32!:
    discard(arguments)
    try verify_rfc6979()
    try derive_rfc6979()
    try signing_roundtrip()
    try ecdh_cases()
    print("PASS p256 4 curve regression cases")
    return 0
