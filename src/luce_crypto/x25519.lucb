## RFC 7748 X25519 (Curve25519 ECDH), the key exchange TLS 1.3 uses. Ported from
## the public-domain TweetNaCl reference: a field element is 16 signed 16-bit
## limbs, and the scalar multiply is a constant-time Montgomery ladder with a
## constant-time conditional swap. Only the public value (a scalar times a point)
## is produced; there is no secret-dependent branching or table lookup.
import luce_crypto.sha2 as sha2

func unpack(out: i64[], input: const u8[]):
    for i in 0..<16:
        out[i] = (i64)input[2 * i] + ((i64)input[2 * i + 1] << 8)
    out[15] &= 0x7fff

## Reduce each limb into 16 bits, folding the carry off the top limb back in with
## the curve's 2^255 = 19 (here 38 after the doubling in `multiply`).
func carry(o: i64[]):
    for i in 0..<16:
        o[i] += 1 << 16
        let c = o[i] >> 16
        if i < 15:
            o[i + 1] += c - 1
        else:
            o[0] += 38 * (c - 1)
        o[i] -= c << 16

func field_add(o: i64[], a: const i64[], b: const i64[]):
    for i in 0..<16:
        o[i] = a[i] + b[i]

func field_sub(o: i64[], a: const i64[], b: const i64[]):
    for i in 0..<16:
        o[i] = a[i] - b[i]

func multiply(o: i64[], a: const i64[], b: const i64[]):
    var t: i64[31]
    for i in 0..<31:
        t[i] = 0
    for i in 0..<16:
        for j in 0..<16:
            t[i + j] += a[i] * b[j]
    for i in 0..<15:
        t[i] += 38 * t[i + 16]
    for i in 0..<16:
        o[i] = t[i]
    carry(o)
    carry(o)

func square(o: i64[], a: const i64[]):
    multiply(o, a, a)

## Constant-time swap of `p` and `q` when `bit` is 1, leaving them when it is 0.
func conditional_swap(p: i64[], q: i64[], bit: i64):
    let mask = ~(bit - 1)
    for i in 0..<16:
        let t = mask & (p[i] ^ q[i])
        p[i] ^= t
        q[i] ^= t

## The field inverse by Fermat: raise to p - 2 with the fixed addition chain from
## the reference (every square, and a multiply except at exponents 2 and 4).
func invert(o: i64[], input: const i64[]):
    var c: i64[16]
    for i in 0..<16:
        c[i] = input[i]
    var exp = 253
    while exp >= 0:
        square(c, c)
        if exp != 2 and exp != 4:
            multiply(c, c, input)
        exp -= 1
    for i in 0..<16:
        o[i] = c[i]

## Fully reduce modulo 2^255 - 19 and emit 32 little-endian bytes.
func pack(o: u8[], n: const i64[]):
    var t: i64[16]
    var m: i64[16]
    for i in 0..<16:
        t[i] = n[i]
    carry(t)
    carry(t)
    carry(t)
    for round in 0..<2:
        m[0] = t[0] - 0xffed
        for i in 1..<15:
            m[i] = t[i] - 0xffff - ((m[i - 1] >> 16) & 1)
            m[i - 1] &= 0xffff
        m[15] = t[15] - 0x7fff - ((m[14] >> 16) & 1)
        let b = (m[15] >> 16) & 1
        m[14] &= 0xffff
        conditional_swap(t, m, 1 - b)
    for i in 0..<16:
        o[2 * i] = (u8)(t[i] & 0xff)
        o[2 * i + 1] = (u8)((t[i] >> 8) & 0xff)

## The X25519 scalar multiply: `out` = `scalar` * `point`, all 32-byte values.
pub func scalarmult(out: u8[], scalar: const u8[], point: const u8[]) -> !:
    if out.length < 32 or scalar.length < 32 or point.length < 32:
        error(sha2.invalid, "X25519 needs 32-byte scalar, point and output")
    var z: u8[32]
    for i in 0..<31:
        z[i] = scalar[i]
    z[31] = (scalar[31] & 127) | 64
    z[0] &= 248
    var x: i64[16]
    unpack(x, point)
    var a: i64[16]
    var b: i64[16]
    var c: i64[16]
    var d: i64[16]
    var e: i64[16]
    var f: i64[16]
    for i in 0..<16:
        a[i] = 0
        b[i] = x[i]
        c[i] = 0
        d[i] = 0
    a[0] = 1
    d[0] = 1
    var k121665: i64[16]
    for i in 0..<16:
        k121665[i] = 0
    k121665[0] = 0xdb41
    k121665[1] = 1
    var i = 254
    while i >= 0:
        let r = ((i64)z[(usize)(i >> 3)] >> (i & 7)) & 1
        conditional_swap(a, b, r)
        conditional_swap(c, d, r)
        field_add(e, a, c)
        field_sub(a, a, c)
        field_add(c, b, d)
        field_sub(b, b, d)
        square(d, e)
        square(f, a)
        multiply(a, c, a)
        multiply(c, b, e)
        field_add(e, a, c)
        field_sub(a, a, c)
        square(b, a)
        field_sub(c, d, f)
        multiply(a, c, k121665)
        field_add(a, a, d)
        multiply(c, c, a)
        multiply(a, d, f)
        multiply(d, b, x)
        square(b, e)
        conditional_swap(a, b, r)
        conditional_swap(c, d, r)
        i -= 1
    invert(c, c)
    multiply(a, a, c)
    pack(out, a)

## `out` = `scalar` * the base point (u = 9): the public value for a private key.
pub func scalarmult_base(out: u8[], scalar: const u8[]) -> !:
    var nine: u8[32]
    for i in 0..<32:
        nine[i] = 0
    nine[0] = 9
    try scalarmult(out, scalar, nine)

func same(a: const u8[], b: const u8[]) -> bool:
    if a.length != b.length:
        return false
    for i in 0..<a.length:
        if a[i] != b[i]:
            return false
    return true

test "x25519 matches RFC 7748 scalar-multiply vectors":
    var out: u8[32]
    try scalarmult(out, b"\xa5\x46\xe3\x6b\xf0\x52\x7c\x9d\x3b\x16\x15\x4b\x82\x46\x5e\xdd\x62\x14\x4c\x0a\xc1\xfc\x5a\x18\x50\x6a\x22\x44\xba\x44\x9a\xc4",
        b"\xe6\xdb\x68\x67\x58\x30\x30\xdb\x35\x94\xc1\xa4\x24\xb1\x5f\x7c\x72\x66\x24\xec\x26\xb3\x35\x3b\x10\xa9\x03\xa6\xd0\xab\x1c\x4c")
    assert(same(out, b"\xc3\xda\x55\x37\x9d\xe9\xc6\x90\x8e\x94\xea\x4d\xf2\x8d\x08\x4f\x32\xec\xcf\x03\x49\x1c\x71\xf7\x54\xb4\x07\x55\x77\xa2\x85\x52"))
    try scalarmult(out, b"\x4b\x66\xe9\xd4\xd1\xb4\x67\x3c\x5a\xd2\x26\x91\x95\x7d\x6a\xf5\xc1\x1b\x64\x21\xe0\xea\x01\xd4\x2c\xa4\x16\x9e\x79\x18\xba\x0d",
        b"\xe5\x21\x0f\x12\x78\x68\x11\xd3\xf4\xb7\x95\x9d\x05\x38\xae\x2c\x31\xdb\xe7\x10\x6f\xc0\x3c\x3e\xfc\x4c\xd5\x49\xc7\x15\xa4\x93")
    assert(same(out, b"\x95\xcb\xde\x94\x76\xe8\x90\x7d\x7a\xad\xe4\x5c\xb4\xb8\x73\xf8\x8b\x59\x5a\x68\x79\x9f\xa1\x52\xe6\xf8\xf7\x64\x7a\xac\x79\x57"))

test "x25519 completes the RFC 7748 Diffie-Hellman example":
    let alice = b"\x77\x07\x6d\x0a\x73\x18\xa5\x7d\x3c\x16\xc1\x72\x51\xb2\x66\x45\xdf\x4c\x2f\x87\xeb\xc0\x99\x2a\xb1\x77\xfb\xa5\x1d\xb9\x2c\x2a"
    let bob = b"\x5d\xab\x08\x7e\x62\x4a\x8a\x4b\x79\xe1\x7f\x8b\x83\x80\x0e\xe6\x6f\x3b\xb1\x29\x26\x18\xb6\xfd\x1c\x2f\x8b\x27\xff\x88\xe0\xeb"
    let shared = b"\x4a\x5d\x9d\x5b\xa4\xce\x2d\xe1\x72\x8e\x3b\xf4\x80\x35\x0f\x25\xe0\x7e\x21\xc9\x47\xd1\x9e\x33\x76\xf0\x9b\x3c\x1e\x16\x17\x42"
    var alice_pub: u8[32]
    var bob_pub: u8[32]
    try scalarmult_base(alice_pub, alice)
    try scalarmult_base(bob_pub, bob)
    assert(same(alice_pub, b"\x85\x20\xf0\x09\x89\x30\xa7\x54\x74\x8b\x7d\xdc\xb4\x3e\xf7\x5a\x0d\xbf\x3a\x0d\x26\x38\x1a\xf4\xeb\xa4\xa9\x8e\xaa\x9b\x4e\x6a"))
    var first: u8[32]
    var second: u8[32]
    try scalarmult(first, alice, bob_pub)
    try scalarmult(second, bob, alice_pub)
    assert(same(first, shared) and same(second, shared))
