## Wycheproof ECDSA P-384 verification with SHA-256 and SHA-384 digests. The
## DER signature decoding here is strict test scaffolding (TLS has its own).
import luce_crypto.p384 as p384
import luce_crypto.sha2 as sha2
import luce_crypto.vector_file as vector_file

## Decode a strict DER Ecdsa-Sig-Value into 48-byte r and s; false if malformed.
func decode_signature(der: const u8[], r: u8[], s: u8[]) -> bool:
    if der.length < 8 or der[0] != 0x30:
        return false
    var at: usize = 2
    var length = (usize)der[1]
    if der[1] == 0x81:
        if der.length < 3 or der[2] < 0x80:
            return false
        length = (usize)der[2]
        at = 3
    elif der[1] >= 0x80:
        return false
    if length != der.length - at:
        return false
    let after_r = integer(der, at, r) else return false
    let after_s = integer(der, after_r, s) else return false
    return after_s == der.length

func integer(der: const u8[], at: usize, out: u8[]) -> usize?:
    if der.length - at < 3 or der[at] != 0x02 or der[at + 1] >= 0x80:
        return none
    let length = (usize)der[at + 1]
    let start = at + 2
    if length == 0 or length > der.length - start or (der[start] & 0x80) != 0:
        return none
    if length > 1 and der[start] == 0 and der[start + 1] < 0x80:
        return none
    var first = start
    var count = length
    if count > 1 and der[first] == 0:
        first += 1
        count -= 1
    if count > out.length:
        return none
    for i in 0..<out.length:
        out[i] = 0
    for i in 0..<count:
        out[out.length - count + i] = der[first + i]
    return start + length

func run_file(directory: str, name: str, algorithm: str, valid: usize*, invalid: usize*) -> !:
    var lines = try vector_file.Lines.open(directory, name)
    defer lines.close()
    var x: u8[48]
    var y: u8[48]
    var message: u8[4096]
    var signature: u8[8192]
    var digest: u8[64]
    while lines.next():
        if try lines.is(0, "key"):
            assert(try lines.decode(1, x) == 48 and try lines.decode(2, y) == 48)
            continue
        let m = try lines.decode(1, message)
        let n = try lines.decode(2, signature)
        let size = try sha2.digest(message[..<m], digest, algorithm)
        var r: u8[48]
        var s: u8[48]
        var accepted = false
        if decode_signature(signature[..<n], r, s):
            accepted = p384.verify(x, y, digest[..<size], r, s) catch: recover false
        if try lines.is(0, "valid"):
            assert(accepted, "valid ECDSA signature rejected")
            *valid += 1
        else:
            assert(not accepted, "invalid ECDSA signature accepted")
            *invalid += 1

## Optional argument: the vector directory (default tests/vectors).
pub func main(arguments: str[]) -> i32!:
    let directory = arguments[1] if arguments.length > 1 else "tests/vectors"
    var valid: usize = 0
    var invalid: usize = 0
    try run_file(directory, "wycheproof_ecdsa_p384_sha256.txt", "sha256", &valid, &invalid)
    try run_file(directory, "wycheproof_ecdsa_p384_sha384.txt", "sha384", &valid, &invalid)
    assert(valid > 100 and invalid > 500)
    print(f"PASS Wycheproof ECDSA P-384 with SHA-256 and SHA-384 ({valid} valid, {invalid} invalid)")
    return 0
